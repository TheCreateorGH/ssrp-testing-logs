+   ═══════════════════════════════════════════════════════════════════════ */
+.admin-table { display: flex; flex-direction: column; gap: 6px; }
+.admin-row {
+    display: grid; grid-template-columns: 1.2fr 1fr .8fr .6fr auto; gap: var(--sp-3); align-items: center;
+    background: var(--panel); border: 1px solid var(--line); border-radius: var(--r-md); padding: var(--sp-3) var(--sp-4);
