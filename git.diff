+
+/* Facility session grouping on the dashboard */
+.session-group + .session-group { margin-top: var(--sp-5); }
+.session-group__head { display: flex; align-items: center; gap: var(--sp-3); cursor: pointer; padding: var(--sp-2) 0; margin-bottom: var(--sp-3); user-select: none; }
+.session-group__chevron { transition: transform var(--t-fast); color: var(--text-dim); }
+.session-group.is-collapsed .session-group__chevron { transform: rotate(-90deg); }
