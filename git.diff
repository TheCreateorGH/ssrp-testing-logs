+.admin-row--pending { border-left: 3px solid var(--caution); }
+.admin-row--approved { border-left: 3px solid var(--clear); }
+.admin-row__user { display: flex; flex-direction: column; gap: 2px; }
+.admin-row__username { font-family: var(--f-mono); font-size: 12.5px; color: var(--text-bright); font-weight: 700; }
+.admin-row__name { font-size: 11px; color: var(--text-dim); }
+.admin-row__role-select, .admin-row__clearance-select { height: 32px; font-size: 11.5px; }
+.admin-row__actions { display: flex; gap: 4px; flex-wrap: wrap; justify-content: flex-end; }
+.admin-table-head { display: grid; grid-template-columns: 1.2fr 1fr .8fr .6fr auto; gap: var(--sp-3); padding: 0 var(--sp-4) var(--sp-2); font-family: var(--f-mono); font-size: 10px; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
+
+.temp-password-display { font-family: var(--f-mono); font-size: 22px; letter-spacing: 2px; text-align: center; padding: var(--sp-4); background: var(--panel-2); border: 1px dashed var(--clear); border-radius: var(--r-md); color: var(--clear); }
+
